{
  "name": "intervona",
  "version": "0.3.0",
  "private": true,
  "description": "Intervona - a local, voice-first AI interview practice platform.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "bash scripts/dev.sh",
    "docker:up": "bash scripts/docker-services.sh up",
    "docker:stop": "bash scripts/docker-services.sh stop",
    "docker:status": "bash scripts/docker-services.sh status",
    "lint": "pnpm --filter @intervona/agent run lint"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.6",
    "typescript": "~5.9.3"
  }
}
