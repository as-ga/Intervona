NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AGENT_API_URL=http://localhost:8000
INTERNAL_API_SECRET=

# PostgreSQL: this Docker default works in local Compose. Replace it with any
# external PostgreSQL URL, for example:
# postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql+asyncpg://intervona:intervona@localhost:55432/intervona

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_AGENT_NAME=intervona-interviewer

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11435/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL_LIVE=qwen3:1.7b
LOCAL_API_KEY=local

STT_PROVIDER=whisper
WHISPER_BASE_URL=http://localhost:8001/v1
WHISPER_MODEL=Systran/faster-whisper-base

TTS_PROVIDER=kokoro
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_MODEL=tts-1
KOKORO_VOICE=

SEARCH_PROVIDER=mock

# Optional AWS S3 storage. When omitted, CVs are stored in ./uploads.
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_URL=

LLM_CALL_TIMEOUT_SEC=300
SCORE_STAGE_TIMEOUT_SEC=300
TRACE_ENABLED=1
